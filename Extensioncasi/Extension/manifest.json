{
  "manifest_version": 3,

  "name": "Asistente LSC",

  "version": "1.0",

  "description": "Traductor contextual LSC",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "videos/*.mp4"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}