{
  "manifest_version": 3,
  "name": "Asistente Accesible",
  "version": "1.0",
  "description": "Extensión para accesibilidad",

  "permissions": ["activeTab", "storage", "scripting"],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["avatar.mp4"],
      "matches": ["<all_urls>"]
    }
  ]
}